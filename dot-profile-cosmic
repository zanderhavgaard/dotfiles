# NOTE: this .profile file is intended to be used alongside cosmic

# Theme
export ICON_THEME="Cosmic"
export XCURSOR_THEME="Colloid-dark-cursors"

# GTK/flatpak theme
export GNOME_THEME="dark"

# QT theme
# qt6ct, not qt5ct, and no QT_STYLE_OVERRIDE: see dot-profile-niri
export QT_QPA_PLATFORMTHEME=qt6ct

# Wayland/riverwm
export MOZ_ENABLE_WAYLAND="1"
export _JAVA_AWT_WM_NONREPARENTING=1
export SDL_VIDEODRIVER=wayland
export QT_QPA_PLATFORM=wayland
export XDG_SESSION_TYPE=wayland

# Japanese input
export QT_IM_MODULE=fcitx
export XMODIFIERS=@im=fcitx
