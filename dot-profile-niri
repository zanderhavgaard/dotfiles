# NOTE: this .profile file is intended to be used alongside niri

# Theme: Colloid-Dark everywhere (GTK2/3/4, icons, cursors, Kvantum).
# Nothing is exported here on purpose. Names live in:
#   gtk-3.0/settings.ini, gtk-4.0/settings.ini, dot-gtkrc-2.0 (GTK2)
#   qt6ct/qt6ct.conf (icon_theme), Kvantum/kvantum.kvconfig (Qt style)
#   fuzzel/fuzzel.ini (icon-theme), niri/config.kdl (cursor)
#   scripts/setup-theme.sh (gsettings, served to Flatpak apps by the portal)
# Do NOT set GTK_THEME: it replaces libadwaita's stylesheet wholesale, so any
# widget the theme doesn't know renders broken. Instead gtk-4.0/gtk.css symlinks
# Colloid's CSS, which GTK loads as user CSS layered on top of libadwaita's.

# Cursor theme is set in niri's `cursor {}` block, not here: niri exports
# XCURSOR_THEME/XCURSOR_SIZE to every client it spawns and overrides this file.

# QT theme
# Must be qt6ct, not qt5ct: only libqt6ct.so exists under
# /usr/lib/qt6/plugins/platformthemes, so qt5ct leaves Qt6 apps with no platform
# theme and makes all of qt6ct.conf inert. Style/icons/colours come from there.
# Do NOT add QT_STYLE_OVERRIDE=kvantum: Kvantum is a QtWidgets style, so QtQuick
# apps (nheko) resolve it as a QML module, fail the import, and render nothing.
export QT_QPA_PLATFORMTHEME=qt6ct

# Wayland/niri
# wayland;xcb so apps without the Qt Wayland plugin fall back to XWayland
# instead of aborting on startup.
export QT_QPA_PLATFORM="wayland;xcb"
export _JAVA_AWT_WM_NONREPARENTING=1
export XDG_SESSION_TYPE=wayland
export XDG_CURRENT_DESKTOP=niri
export XDG_SESSION_DESKTOP=niri

# Japanese input
export QT_IM_MODULE=fcitx
export XMODIFIERS=@im=fcitx
