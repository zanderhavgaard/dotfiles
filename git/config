[alias]
	a = "add -u ."
	aliases = "!git config --list | grep 'alias\\.' | sed 's/alias\\.\\([^=]*\\)=\\(.*\\)/\\1\\ \t => \\2/' | sort"
	b = "branch -av"
	c = "checkout"
	ci = "clean -i"
	cm = "commit -m"
	fp = "push --force-with-lease"
	g = "!git log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %C(bold blue)<%an>%Creset %Cgreen(%cr)%Creset %s' --abbrev-commit --date=relative --all"
	l = "!git log --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %C(bold blue)<%an>%Creset %Cgreen(%cr)%Creset %s' --abbrev-commit --date=relative -n 10"
	la = "!git log --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %C(bold blue)<%an>%Creset %Cgreen(%cr)%Creset %s' --abbrev-commit --date=relative -n 10 --all"
	lag = "!git log --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %C(bold blue)<%an>%Creset %Cgreen(%cr)%Creset %s' --abbrev-commit --date=relative -n 10 --all --graph"
	nb = "checkout -b"
	p = "push"
	pt = "push --tags"
	rmb = "branch --delete --force"
	s = "status"
	sha = "rev-parse HEAD"
	unstage = "reset HEAD --"
  pile = "commit --amend -n --no-edit"

[color]
	ui = true

[commit]
	gpgSign = true

[core]
	editor = "nvim"
	pager = "delta"

[delta]
	# Tokyo Night: syntax from bat's theme (bat/themes/TokyoNight.tmTheme),
	# diff colours from tokyonight.nvim's delta extra
	light = false
	line-numbers = true
	navigate = true
	side-by-side = true
	syntax-theme = "TokyoNight"
	minus-style = "syntax #37222c"
	minus-emph-style = "syntax #713137"
	plus-style = "syntax #20303b"
	plus-emph-style = "syntax #2c5a66"
	zero-style = "syntax"
	line-numbers-minus-style = "#f7768e"
	line-numbers-plus-style = "#73daca"
	line-numbers-zero-style = "#3b4261"
	line-numbers-left-style = "#292e42"
	line-numbers-right-style = "#292e42"
	file-style = "#7aa2f7 bold"
	file-decoration-style = "#3b4261 ul"
	hunk-header-style = "file line-number syntax"
	hunk-header-decoration-style = "#3b4261 box"
	hunk-header-file-style = "#7aa2f7"
	hunk-header-line-number-style = "#565f89"

[gpg]
	program = "gpg2"

[interactive]
	diffFilter = "delta --color-only --line-numbers"

[pull]
	rebase = true

[push]
	autoSetupRemote = true

[tag]
	gpgSign = false

