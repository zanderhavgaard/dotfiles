[alias]
	a = "add -u ."
	aliases = "!git config --list | grep 'alias\\.' | sed 's/alias\\.\\([^=]*\\)=\\(.*\\)/\\1\\ \t => \\2/' | sort"
	b = "branch -av"
	c = "checkout"
	ci = "clean -i"
	cm = "commit -m"
	fp = "push --force-with-lease"
	g = "!git log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %C(bold blue)<%an>%Creset %Cgreen(%cr)%Creset %s' --abbrev-commit --date=relative --all"
	l = "!git log --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %C(bold blue)<%an>%Creset %Cgreen(%cr)%Creset %s' --abbrev-commit --date=relative -n 10"
	la = "!git log --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %C(bold blue)<%an>%Creset %Cgreen(%cr)%Creset %s' --abbrev-commit --date=relative -n 10 --all"
	lag = "!git log --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %C(bold blue)<%an>%Creset %Cgreen(%cr)%Creset %s' --abbrev-commit --date=relative -n 10 --all --graph"
	nb = "checkout -b"
	p = "push"
	pt = "push --tags"
	rmb = "branch --delete --force"
	s = "status"
	sha = "rev-parse HEAD"
	unstage = "reset HEAD --"
  pile = "commit --amend -n --no-edit"

[color]
	ui = true

[commit]
	gpgSign = true

[core]
	editor = "nvim"
	pager = "delta"

[delta]
	# Kanagawa Wave: syntax from bat's theme (bat/themes/Kanagawa.tmTheme),
	# diff backgrounds are kanagawa.nvim's winterGreen / winterRed
	light = false
	line-numbers = true
	navigate = true
	side-by-side = true
	syntax-theme = "Kanagawa"
	minus-style = "syntax #43242B"
	minus-emph-style = "syntax #6A2E38"
	plus-style = "syntax #2B3328"
	plus-emph-style = "syntax #3E5235"
	zero-style = "syntax"
	line-numbers-minus-style = "#E46876"
	line-numbers-plus-style = "#98BB6C"
	line-numbers-zero-style = "#54546D"
	line-numbers-left-style = "#363646"
	line-numbers-right-style = "#363646"
	file-style = "#E6C384 bold"
	file-decoration-style = "#54546D ul"
	hunk-header-style = "file line-number syntax"
	hunk-header-decoration-style = "#54546D box"
	hunk-header-file-style = "#7E9CD8"
	hunk-header-line-number-style = "#727169"

[gpg]
	program = "gpg2"

[interactive]
	diffFilter = "delta --color-only --line-numbers"

[pull]
	rebase = true

[push]
	autoSetupRemote = true

[tag]
	gpgSign = false

