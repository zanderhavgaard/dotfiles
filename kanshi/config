output "Dell Inc. DELL U4323QE *" {
  enable
  alias $office
  transform normal
  scale 1
  mode 3840x2160@59.997002
}

output "Lenovo Group Limited 0x403D *" {
  enable
  alias $gemini
  transform normal
  scale 1
  mode 1920x1200
  position 0,0
}

# gemini, docked at office
profile docked {
  output $gemini {
    position 0,0
  }
  output $office {
    position 1920,0
  }
}

# gemini, no monitors
profile gemini {
  output $gemini
}

output "Philips Consumer Electronics Company PHL 40B1U5600 *" {
  enable
  alias $home-phillips
  transform normal
  scale 1
  mode 3440x1440@120.000000
  position 0,0
}

output "Ancor Communications Inc ASUS MG279 *" {
  enable
  alias $home-asus
  transform normal
  scale 1
  mode 2560x1440@59.951000
  position 3440,0
}

profile home-workstation {
 output $home-phillips
 output $home-asus
}

output "BOE NE135A1M-NY1 *" {
  enable
  alias $framework
  transform normal
  scale 2
  mode 2880x1920@120.000000
  position 0,0
}

# framework alone
profile framework {
  output $framework
}

# framework at home, phillips above the laptop screen, laptop centered below
# (framework is 1440x960 logical at scale 2, so x = (3440 - 1440) / 2 = 1000)
profile framework-home {
  output $home-phillips {
    mode 3440x1440@99.982002
    position 0,0
  }
  output $framework {
    position 1000,1440
  }
}
