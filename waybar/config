[
  {
    "backlight": {
      "format": "{percent}% {icon}",
      "format-icons": [
        "",
        "",
        "",
        "",
        "",
        "",
        "",
        "",
        ""
      ]
    },
    "battery": {
      "format": "{capacity}% {icon}",
      "format-alt": "{time} {icon}",
      "format-charging": "{capacity}% 󱐋",
      "format-icons": [
        "",
        "",
        "",
        "",
        ""
      ],
      "format-plugged": "{capacity}% ",
      "states": {
        "critical": 15,
        "warning": 30
      }
    },
    "clock#default": {
      "format": "{:%H:%M 󰥔 %d/%m %b %Y }",
      "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
    },
    "clock#extra1": {
      "format": "{:%H:%M (JP)}",
      "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
      "timezone": "Asia/Tokyo"
    },
    "clock#extra2": {
      "format": "{:%H:%M (NZ)}",
      "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
      "timezone": "Pacific/Auckland"
    },
    "custom/kernel": {
      "exec": "echo \"󰣇 $(uname -r)\""
    },
    "custom/vpn": {
      "exec": "~/.config/waybar/vpn-status.sh",
      "return-type": "json",
      "interval": 5,
      "tooltip": true,
      "on-click": "~/.config/waybar/vpn-status.sh toggle-netbird",
      "on-click-right": "~/.config/waybar/vpn-status.sh toggle-mullvad"
    },
    "height": 30,
    "margin-top": 10,
    "margin-left": 10,
    "margin-right": 10,
    "idle_inhibitor": {
      "format": "{icon}",
      "format-icons": {
        "activated": "󰅶",
        "deactivated": "󰛊"
      }
    },
    // "niri/workspaces": {
    //   "format": "{icon}",
    //   "format-icons": {
    //     "active": "",
    //     "default": ""
    //   }
    // },
    "niri/language": {
      "format": "{short}  "
    },
    "layer": "top",
        "modules-left": [
      "niri/workspaces",
    ],
    "modules-center": [
      "clock#default"
    ],
    "modules-right": [
      "group/clocks",
      "pulseaudio",
      "group/net",
      "group/hw",
      "custom/kernel",
      "group/sys"
    ],
    "group/clocks": {
      "orientation": "inherit",
      "modules": [
        "clock#extra1",
        "clock#extra2"
      ]
    },
    "group/net": {
      "orientation": "inherit",
      "modules": [
        "network",
        "custom/vpn"
      ]
    },
    "group/hw": {
      "orientation": "inherit",
      "modules": [
        "backlight",
        "battery",
        "niri/language"
      ]
    },
    "group/sys": {
      "orientation": "inherit",
      "modules": [
        "idle_inhibitor",
        "tray"
      ]
    },
    "network": {
      "format-alt": "{ifname}: {ipaddr}/{cidr}",
      "format-disconnected": "Disconnected ⚠",
      "format-ethernet": "{ipaddr}/{cidr} 󰈁",
      "format-linked": "{ifname} (No IP) 󰈂",
      "format-wifi": "{essid} ({signalStrength}%) ",
      "tooltip-format": "{gwaddr} via {ifname} 󰈀 "
    },
    "position": "top",
    "pulseaudio": {
      "format": "{volume}% {icon} {format_source}",
      "format-bluetooth": "{volume}% {icon} {format_source}",
      "format-bluetooth-muted": "󰖁 {icon} {format_source}",
      "format-icons": {
        "car": "",
        "default": [
          "",
          "",
          ""
        ],
        "hands-free": "hands-free",
        "headphone": "",
        "headset": "headset",
        "phone": "",
        "portable": ""
      },
      "format-muted": "󰖁 {format_source}",
      "format-source": "{volume}% ",
      "format-source-muted": "",
      "on-click": "pwvucontrol"
    },
    "spacing": 0,
    "tray": {
      "spacing": 5
    }
  }
]
