set selection-clipboard clipboard

# Tokyo Night (same palette as quickshell/Theme.qml)
set font                    "MartianMono Nerd Font 9"

set default-bg              "#1A1B26"
set default-fg              "#C0CAF5"

set statusbar-bg            "#16161E"
set statusbar-fg            "#A9B1D6"
set inputbar-bg             "#16161E"
set inputbar-fg             "#C0CAF5"

set notification-bg         "#16161E"
set notification-fg         "#C0CAF5"
set notification-error-bg   "#16161E"
set notification-error-fg   "#F7768E"
set notification-warning-bg "#16161E"
set notification-warning-fg "#E0AF68"

set completion-bg           "#16161E"
set completion-fg           "#A9B1D6"
set completion-group-bg     "#16161E"
set completion-group-fg     "#7AA2F7"
set completion-highlight-bg "#283457"
set completion-highlight-fg "#C0CAF5"

set index-bg                "#1A1B26"
set index-fg                "#C0CAF5"
set index-active-bg         "#283457"
set index-active-fg         "#C0CAF5"

# search hits: bg_visual blue, the current one orange
set highlight-color         "rgba(61, 89, 161, 0.5)"
set highlight-fg            "#C0CAF5"
set highlight-active-color  "rgba(255, 158, 100, 0.5)"

set render-loading          true
set render-loading-bg       "#1A1B26"
set render-loading-fg       "#565F89"

# ctrl+r: dark mode for documents (paper → bg, ink → fg)
set recolor-lightcolor      "#1A1B26"
set recolor-darkcolor       "#C0CAF5"
set recolor-keephue         true
